    <application>
        <activity
            android:name="org.sableos.games.SableGameActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:resizeableActivity="true"
            android:theme="@android:style/Theme.Material.NoActionBar" />
        <!-- A unique launcher component per top-level game gives each game its own task identity in
             Recents and makes it independently discoverable by system launchers. OpenMink filters
             its own package from ordinary app discovery and exposes these through its game catalog.
             The route-less host above remains private. -->
        <activity
            android:name="org.sableos.games.SudokuActivity"
            android:icon="@mipmap/ic_sable_app_sudoku"
            android:label="@string/task_label_sudoku"
            android:documentLaunchMode="intoExisting"
            android:configChanges="orientation|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:excludeFromRecents="false"
            android:exported="true"
            android:launchMode="standard"
            android:resizeableActivity="true"
            android:taskAffinity="${applicationId}.sablegames.sudoku"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <property
                android:name="android.window.PROPERTY_SUPPORTS_MULTI_INSTANCE_SYSTEM_UI"
                android:value="true" />
        </activity>
